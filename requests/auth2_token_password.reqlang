```%config
secrets = ["password"]

[[vars]]
name = "clientId"

[[vars]]
name = "username"

[envs.default]
username = "username"
clientId = "default-client-id"
```

```%request
POST http://localhost:3003/{{@env}}/token HTTP/1.1
content-type: application/x-www-form-urlencoded

grant_type=password&username={{:username}}&password={{!password}}&client_id={{:clientId}}
```